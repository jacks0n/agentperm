// A real-world global policy. Shell(...) collapses hundreds of Bash(...) lines into a few.
{
  "version": 1,
  "permissions": {
    "allow": [
      // --- Git (read-only, with -C support) ---
      "Shell(git {blame,branch,check-ignore,diff,fetch,grep,log,ls-files,ls-remote,ls-tree,merge-base,remote,rev-list,rev-parse,show,status} values(-C))",
      "Shell(git stash {list,show} values(-C))",

      // --- GitHub CLI (read-only) ---
      "Shell(gh pr {checks,diff,list,status,view} values(--repo,--json,--jq))",
      "Shell(gh run {list,view,watch} values(--repo,--json,--jq))",
      "Shell(gh issue {list,view})",
      "Shell(gh search {issues,repos})",
      "Shell(gh variable {get,list})",
      "Shell(gh workflow {list,view})",
      "Shell(gh api !{graphql} !{-X,--method,-f,--raw-field,-F,--field,--input,-H,--header})",
      "Shell(gh auth status --hostname=* !-*)",

      // --- AWS (read-only — glob-per-service covers describe/get/list) ---
      "Shell(aws acm {describe-*,list-*})",
      "Shell(aws apigateway get-*)",
      "Shell(aws ce get-*)",
      "Shell(aws cloudformation {describe-*,get-*,list-*})",
      "Shell(aws cloudfront {get-*,list-*})",
      "Shell(aws cloudtrail {describe-*,get-*,lookup-*})",
      "Shell(aws cloudwatch {describe-*,get-*,list-*})",
      "Shell(aws codebuild batch-get-*)",
      "Shell(aws cognito-idp {describe-*,list-*})",
      "Shell(aws configure list*)",
      "Shell(aws dynamodb {describe-*,list-*})",
      "Shell(aws ec2 describe-*)",
      "Shell(aws ecs {describe-*,list-*})",
      "Shell(aws eks {describe-*,list-*})",
      "Shell(aws elasticache describe-*)",
      "Shell(aws elbv2 describe-*)",
      "Shell(aws events {describe-*,list-*})",
      "Shell(aws iam {get-*,list-*,simulate-*})",
      "Shell(aws kms {describe-*,list-*})",
      "Shell(aws lambda {get-*,list-*})",
      "Shell(aws logs {describe-*,filter-*,get-*,start-query,tail})",
      "Shell(aws organizations {describe-*,list-*})",
      "Shell(aws rds {describe-*,list-*})",
      "Shell(aws resourcegroupstaggingapi get-*)",
      "Shell(aws route53 {get-*,list-*})",
      "Shell(aws route53resolver list-*)",
      "Shell(aws s3 ls)",
      "Shell(aws s3api {get-*,head-*,list-*})",
      "Shell(aws secretsmanager {describe-*,list-*})",
      "Shell(aws ses {get-*,list-*})",
      "Shell(aws sesv2 get-*)",
      "Shell(aws sns {get-*,list-*})",
      "Shell(aws sqs {get-*,list-*})",
      "Shell(aws ssm {describe-*,get-*,list-*})",
      "Shell(aws sts get-*)",
      "Shell(aws synthetics {describe-*,get-*})",
      "Shell(aws xray {batch-get-*,get-*})",

      // --- Docker (read + build) ---
      "Shell(docker compose {build,up})",
      "Shell(docker {logs,ps})",

      // --- Language tooling ---
      "Shell(npm {audit,search,view})",
      "Shell(npx {eslint,tsc})",
      "Shell(pnpm {add,exec,install,list,test,why})",
      "Shell(pnpm run {build,lint,lint:fix})",
      "Shell(uv run pytest)",
      "Shell(uv pip {check,freeze,list,show,tree})",
      "Shell(pip {check,freeze,help,inspect,list,show})",
      "Shell({./.venv/bin/python,python3} -m json.tool)",
      "Shell(python3 -m py_compile)",
      "Shell(node)",
      "Shell(make)",
      "Shell(php -l)",

      // --- General CLI ---
      "Shell(... {--version,--help} !... !-*)",
      "Shell(sleep)",
      "Shell(export {AWS_PROFILE,GH_HOST}=*)",
      "Shell(ip addr)",
      "Shell(nvim --version)",
      "Shell(defaults read)",
      "Shell(op item {get,list})",
      "Shell(time {source,zsh})",
      "Shell(az account show)",
      "Shell(done !... !-*)",

      // --- Shell builtins ---
      "Shell({:,alias,cd,echo,exit,false,popd,printf,pushd,pwd,test,true,type})",

      // --- Read-only utilities ---
      "Shell({ag,awk,cat,cmp,comm,cut,diff,du,egrep,fgrep,file,find,grep,gsed,head,jq,less,locate,ls,more,nl,readlink,realpath,rg,sed,sort,stat,tail,tr,tree,uniq,wc,xargs,zipinfo})",
      "Shell({date,df,dig,env,free,help,host,hostname,htop,id,ifconfig,info,iostat,lsof,man,mdfind,mdls,netstat,nslookup,pgrep,ping,printenv,ps,ss,top,traceroute,uname,uptime,vmstat,w,whatis,whereis,which,who,whoami})",

      // --- Inline Python analysis ---
      "Python(readonly)",

      // --- Non-shell tools ---
      "Glob",
      "Grep",
      "LS",
      "Read",
      "Search",
      "WebFetch",
      "WebSearch",
      "mcp__Context7__query-docs",
      "mcp__sequential-thinking__sequentialthinking"
    ],
    "ask": [
      {
        "tool": "Bash",
        "command": ["sed", "gsed"],
        "when": { "hasOption": ["-i", "--in-place"] },
        "reason": "sed in-place editing changes files"
      }
    ],
    "deny": [
      "Shell(sudo)",
      "Shell(su)",
      "Shell(rm -r -f /*)",
      "Shell(format)",
      "Shell(fdisk)"
    ]
  },
  "shell": {
    "redirection": {
      "stderrToDevNull": "allow",
      "stdoutToDevNull": "allow",
      "stdoutToFile": "ask",
      "appendToFile": "ask",
      "allowPaths": ["/tmp", "/private/tmp/claude-*"]
    }
  }
}
