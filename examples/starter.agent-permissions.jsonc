// Minimal starting policy. Grow from here.
// Global: ~/.agent-permissions.jsonc  ·  Per-repo: <repo>/.agent-permissions.jsonc
{
  "version": 1,
  "permissions": {
    "allow": [
      "Shell({cat,grep,head,ls,rg,tail,wc})",
      "Shell(git {status,diff,log,show})",
      "Shell(sed !{-i,--in-place})",
      "Python(readonly)",
      "Read",
      "Grep",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      {
        "tool": "Bash",
        "command": ["sed", "gsed"],
        "when": { "hasOption": ["-i", "--in-place"] },
        "reason": "sed in-place editing changes files"
      }
    ],
    "deny": [
      "Shell(sudo)",
      "Shell(rm -r -f /*)"
    ]
  },
  "shell": {
    "redirection": {
      "stderrToDevNull": "allow",
      "stdoutToFile": "ask",
      "appendToFile": "ask",
      "allowPaths": ["/tmp"]
    }
  }
}
